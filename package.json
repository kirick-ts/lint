{
	"name": "@kirick/lint",
	"version": "0.3.3",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": "dist/main.mjs",
	"exports": {
		"./oxlint": {
			"types": "./configs/oxlint.d.ts",
			"default": "./configs/oxlint.js"
		},
		"./eslint": {
			"types": "./configs/eslint.d.ts",
			"default": "./configs/eslint.js"
		}
	},
	"engines": {
		"node": ">=22.16"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "5.10.0",
		"eslint-plugin-jsdoc": "62.9.0",
		"eslint-plugin-n": "17.24.0",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-unicorn": "64.0.0",
		"eslint-plugin-vue": "10.8.0",
		"typescript-eslint": "8.58.0"
	},
	"peerDependencies": {
		"eslint": "10.2.0",
		"oxlint": "1.75.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/bun": "1.3.11",
		"publint": "0.3.18",
		"tsdown": "0.22.0",
		"type-fest": "5.5.0",
		"typescript": "6.0.2",
		"valibot": "1.3.1"
	},
	"scripts": {
		"build": "tsdown src/main.ts --dts=false --format esm",
		"check": "bun run lint && bun run build",
		"lint": "biome format && oxlint && eslint . && tsc",
		"# lint:prettier": "prettier --check **/*.vue",
		"# postinstall": "bun run --bun dist/main.mjs",
		"rules": "bun test/rules.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirick-ts/lint.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kirick-ts/lint/issues"
	},
	"homepage": "https://github.com/kirick-ts/lint#readme"
}
