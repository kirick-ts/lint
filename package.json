{
	"name": "@kirick/lint",
	"version": "0.4.0",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"lint-upgrade": "dist/main.mjs",
		"lint": "lint.sh"
	},
	"exports": {
		"./oxlint": {
			"types": "./configs/oxlint.d.ts",
			"default": "./configs/oxlint.js"
		},
		"./eslint": {
			"types": "./configs/eslint.d.ts",
			"default": "./configs/eslint.js"
		}
	},
	"engines": {
		"node": "^22.16"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "5.10.0",
		"eslint-plugin-jsdoc": "63.1.0",
		"eslint-plugin-n": "18.2.2",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-unicorn": "72.0.0",
		"eslint-plugin-vue": "10.9.2",
		"typescript-eslint": "8.64.0"
	},
	"peerDependencies": {
		"eslint": "10.7.0",
		"oxlint": "1.74.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/node": "22.16.5",
		"publint": "0.3.21",
		"tsdown": "0.22.9",
		"type-fest": "5.8.0",
		"typescript": "npm:typescript-native-bridge@6.0.3-bridge.6.tsgo.7.0.2",
		"valibot": "1.4.2"
	},
	"scripts": {
		"build": "tsdown src/main.ts --dts=false --format esm",
		"check": "bun run lint && bun run build",
		"lint": "biome format && oxlint && eslint . && tsc",
		"# lint:prettier": "prettier --check **/*.vue",
		"# postinstall": "bun run --bun dist/main.mjs",
		"rules": "bun test/rules.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirick-ts/lint.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kirick-ts/lint/issues"
	},
	"homepage": "https://github.com/kirick-ts/lint#readme"
}
